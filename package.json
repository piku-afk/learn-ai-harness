{
  "name": "ai-harness",
  "version": "0.0.0",
  "description": "learning how to build harness for ai",
  "type": "module",
  "scripts": {
    "hello": "tsx --env-file=.env apps/hello-world/index.ts",
    "translator": "tsx --env-file=.env apps/translator/src/index.ts",
